{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "capturedAt", "harness", "context", "reports", "outputs", "aggregate"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suiteId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "model", "modelSnapshot", "reasoning", "sandbox", "timeoutSeconds"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "modelSnapshot": { "type": ["string", "null"] },
        "reasoning": { "type": "string", "minLength": 1 },
        "sandbox": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    },
    "context": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "reports": { "$ref": "#/$defs/artifact" },
    "outputs": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["promptId", "path", "sha256"],
        "properties": {
          "promptId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lintErrorsPerHundredLines", "sheenInteractionCoverage", "rubricPassRatio"],
      "properties": {
        "lintErrorsPerHundredLines": { "type": "number", "minimum": 0 },
        "sheenInteractionCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "rubricPassRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
