{
  "name": "@gemologic/sheen-code",
  "version": "0.1.0-rc.0",
  "description": "Code, diff, log, and JSON viewers for the Sheen SolidJS design system.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/gemologic/sheen.git", "directory": "packages/code" },
  "homepage": "https://sheen.gemologic.dev",
  "bugs": { "url": "https://github.com/gemologic/sheen/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!dist/**/*.demo.*",
    "!dist/**/*.meta.*",
    "!src/**/*.test.*",
    "!src/**/*.demo.*",
    "!src/**/*.meta.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "solid": "./src/highlight.ts",
      "import": "./dist/highlight.js"
    },
    "./diff-viewer": { "types": "./dist/DiffViewer.d.ts", "solid": "./src/DiffViewer.tsx", "import": "./dist/DiffViewer.js" },
    "./log-viewer": { "types": "./dist/LogViewer.d.ts", "solid": "./src/LogViewer.tsx", "import": "./dist/LogViewer.js" },
    "./json-viewer": { "types": "./dist/JSONViewer.d.ts", "solid": "./src/JSONViewer.tsx", "import": "./dist/JSONViewer.js" },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@gemologic/sheen": "workspace:*",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@gemologic/sheen": "workspace:*",
    "solid-js": "1.9.15",
    "vite-plugin-solid": "2.11.14"
  },
  "dependencies": {
    "shiki": "4.4.3"
  }
}
