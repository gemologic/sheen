{
  "name": "@gemologic/sheen",
  "version": "0.1.0",
  "description": "Accessible, themeable SolidJS components for application interfaces.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/gemologic/sheen.git", "directory": "packages/ui" },
  "homepage": "https://sheen.gemologic.dev",
  "bugs": { "url": "https://github.com/gemologic/sheen/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "files": [
    "dist",
    "src",
    "vendor",
    "THIRD_PARTY_NOTICES.md",
    "!dist/**/*.test.*",
    "!dist/**/*.demo.*",
    "!dist/**/*.meta.*",
    "!src/**/*.test.*",
    "!src/**/*.demo.*",
    "!src/**/*.meta.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#sheen-kobalte": { "types": "./vendor/kobalte-core/index.d.ts", "solid": "./vendor/kobalte-core/index.jsx", "default": "./vendor/kobalte-core/index.js" },
    "#sheen-kobalte/*": { "types": "./vendor/kobalte-core/*/index.d.ts", "solid": "./vendor/kobalte-core/*/index.jsx", "default": "./vendor/kobalte-core/*/index.js" },
    "#sheen-kobalte-utils": { "types": "./vendor/kobalte-utils/index.d.ts", "default": "./vendor/kobalte-utils/index.js" },
    "#sheen-cmdk": { "types": "./vendor/cmdk-solid/index.d.ts", "solid": "./vendor/cmdk-solid/index.jsx", "default": "./vendor/cmdk-solid/index.js" }
  },
  "exports": {
    "./vite": { "types": "./dist/vite.d.ts", "import": "./dist/vite.js" },
    "./solid-web": {
      "types": "./vendor/solid-web/types/index.d.ts",
      "worker": { "import": "./vendor/solid-web/server.js", "require": "./vendor/solid-web/server.cjs" },
      "browser": {
        "development": { "import": "./vendor/solid-web/dev.js", "require": "./vendor/solid-web/dev.cjs" },
        "import": "./vendor/solid-web/web.js", "require": "./vendor/solid-web/web.cjs"
      },
      "node": { "import": "./vendor/solid-web/server.js", "require": "./vendor/solid-web/server.cjs" },
      "development": { "import": "./vendor/solid-web/dev.js", "require": "./vendor/solid-web/dev.cjs" },
      "import": "./vendor/solid-web/web.js", "require": "./vendor/solid-web/web.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "solid": "./src/core.ts",
      "import": "./dist/core.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "solid": "./src/forms.ts",
      "import": "./dist/forms.js"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "solid": "./src/overlays.ts",
      "import": "./dist/overlays.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "solid": "./src/navigation.ts",
      "import": "./dist/navigation.js"
    },
    "./formisch": {
      "types": "./dist/formisch.d.ts",
      "solid": "./src/formisch.ts",
      "import": "./dist/formisch.js"
    },
    "./theme-script": {
      "types": "./dist/theme/script.d.ts",
      "solid": "./src/theme/script.ts",
      "import": "./dist/theme/script.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "solid": "./src/metadata.ts",
      "import": "./dist/metadata.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@formisch/solid": ">=1 <2",
    "solid-js": "1.9.15",
    "vite": ">=8 <9"
  },
  "peerDependenciesMeta": {
    "@formisch/solid": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@corvu/resizable": "0.2.5",
    "@gemologic/sheen-tokens": "workspace:*",
    "@floating-ui/dom": "^1.5.1",
    "@internationalized/number": "^3.2.1",
    "@solid-primitives/event-listener": "^2.2.14",
    "@solid-primitives/keyed": "^1.2.0",
    "@solid-primitives/map": "^0.4.7",
    "@solid-primitives/media": "^2.2.4",
    "@solid-primitives/props": "^3.1.8",
    "@solid-primitives/refs": "^1.0.5",
    "@solid-primitives/resize-observer": "^2.0.26",
    "@solid-primitives/utils": "^6.2.1",
    "clsx": "2.1.1",
    "solid-presence": "^0.2.0",
    "solid-prevent-scroll": "^0.1.11"
  },
  "devDependencies": {
    "@formisch/solid": "1.0.0",
    "solid-js": "1.9.15",
    "valibot": "1.4.2"
  }
}
