{
  "name": "@gemologic/sheen-charts",
  "version": "0.2.1",
  "description": "Accessible SVG and canvas chart components for the Sheen SolidJS design system.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/gemologic/sheen.git", "directory": "packages/charts" },
  "homepage": "https://sheen.gemologic.dev",
  "bugs": { "url": "https://github.com/gemologic/sheen/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!dist/**/*.demo.*",
    "!dist/**/*.meta.*",
    "!src/**/*.test.*",
    "!src/**/*.demo.*",
    "!src/**/*.meta.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "solid": "./src/core.ts",
      "import": "./dist/core.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "solid": "./src/svg.ts",
      "import": "./dist/svg.js"
    },
    "./charts-svg": {
      "types": "./dist/charts-svg.d.ts",
      "solid": "./src/charts-svg.ts",
      "import": "./dist/charts-svg.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "solid": "./src/table.ts",
      "import": "./dist/table.js"
    },
    "./time-series": {
      "types": "./dist/time-series.d.ts",
      "solid": "./src/time-series.ts",
      "import": "./dist/time-series.js"
    },
    "./streaming": {
      "types": "./dist/streaming.d.ts",
      "solid": "./src/streaming.ts",
      "import": "./dist/streaming.js"
    },
    "./loupe": {
      "types": "./dist/loupe.d.ts",
      "solid": "./src/loupe.ts",
      "import": "./dist/loupe.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@gemologic/sheen": "workspace:*",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@gemologic/sheen": "workspace:*",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "solid-js": "1.9.15",
    "vite-plugin-solid": "2.11.14"
  },
  "dependencies": {
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "uplot": "1.6.32"
  }
}
